# Oturum çerezlerini imzalamak için en az 32 karakterlik gizli anahtar.
# Üretim ortamında MUTLAKA değiştirin:  openssl rand -base64 48
SESSION_SECRET=gelistirme-icin-degistirilmesi-gereken-uzun-bir-anahtar

# SQLite veritabanı dosyası (varsayılan: data/app.db)
DATABASE_PATH=data/app.db

# Bildirim fotoğraflarının saklandığı klasör (varsayılan: data/uploads)
UPLOAD_DIR=data/uploads

# QR kodlarda kullanılacak sitenin tam adresi
PUBLIC_BASE_URL=http://localhost:3000
